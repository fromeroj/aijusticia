# ============================================================
# AI Justicia — Motor LLM + RAG · Variables de entorno
# Copia este archivo a .env y ajusta los valores.
# ============================================================

# --- Inferencia (LM Studio corriendo local) ---
# LM Studio expone una API OpenAI-compatible en http://localhost:1234/v1
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_API_KEY=lm-studio
# Modelo LLM para generación (debe estar cargado en LM Studio)
LMSTUDIO_LLM_MODEL=qwen3.6-35b-a3b
# Modelo de embeddings para el índice vectorial
LMSTUDIO_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5

# --- PostgreSQL + pgvector ---
DATABASE_URL=postgresql+psycopg://aijusticia:aijusticia@localhost:5433/aijusticia
PG_HOST=localhost
PG_PORT=5433
PG_DB=aijusticia
PG_USER=aijusticia
PG_PASSWORD=aijusticia

# --- Pipeline / umbrales ---
# Umbral de calidad de recuperación (0-1). Si cae debajo, se reformula y reintenta.
RETRIEVAL_QUALITY_THRESHOLD=0.35
# Número de pasajes a recuperar (k híbrido)
RETRIEVAL_TOP_K=8
# Número de pasajes tras reranking
RERANK_TOP_K=4
# Umbral de implicación NLI (0-1): probabilidad mínima de "entails" para dar por buena una cita
NLI_ENTAILMENT_THRESHOLD=0.55
# Proporción mínima de oraciones con respaldo fuerte; si cae debajo, el sistema se abstiene
ABSTENTION_MIN_BACKED_RATIO=0.6

# --- OCR ---
TESSERACT_CMD=/opt/homebrew/bin/tesseract

# --- App ---
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
